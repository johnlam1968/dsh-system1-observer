{
  "name": "dsh-profile-docdrift",
  "private": true,
  "description": "DocDrift as an end-user app: the Web UI, with DocDrift's capability in it. Copy this directory to $DSH_HOME/profiles/docdrift and boot it.",
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
