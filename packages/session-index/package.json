{
  "name": "dsh-session-index",
  "version": "0.1.0",
  "type": "module",
  "description": "A derived SQLite index over DSH session logs: FTS5 search over message text, reasoning, tool calls and results, title/cwd lookup, and an incremental rebuild. Imports no dsh code.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./store": "./lib/store.js",
    "./refresh": "./lib/refresh.js",
    "./build": "./lib/build.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "session-index": "./bin/session-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "bin/*.mjs",
    "cordis.patch.yml",
    "package.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
