{
  "name": "dsh-session-adapter",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "The DSH session surface this repository's plugins are thin adapters over: the harness's event vocabulary in one home, the model-surface fold, the per-session event feed, and the sessionQuery-backed reads -- as importable functions AND as a `sessionAdapter` service.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./session-format": "./lib/session-format.js",
    "./surface": "./lib/surface.js",
    "./feed": "./lib/feed.js",
    "./reader": "./lib/reader.js",
    "./surface-authority": "./lib/surface-authority.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish-tag.mjs"
  },
  "files": [
    "LICENSE",
    "index.js",
    "lib/**/*.js",
    "package.json",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlam1968/dsh-system1-observer.git",
    "directory": "packages/session-adapter"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "session",
    "adapter"
  ],
  "bugs": {
    "url": "https://github.com/johnlam1968/dsh-system1-observer/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "testedAgainst": {
        "node": "25.3.0",
        "dsh": "0.1.7-rc.2",
        "note": "Re-run `npm run ci` after upgrading Node or DSH, and update these two versions only then."
      }
    }
  }
}
